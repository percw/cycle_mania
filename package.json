    "test:erg": "node scripts/erg-smoke.mjs",
    "test:ui": "node scripts/ui-smoke.mjs",
    "test:expedition": "node scripts/expedition-smoke.mjs"
  },
  "dependencies": {
    "@garmin/fitsdk": "21.217.0",
    "@vercel/analytics": "2.0.1",
